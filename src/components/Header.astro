---
const path = Astro.url.pathname;
const links = [
  { label: 'Home', href: '/', active: path === '/' },
  { label: 'Work', href: '/#work', active: false },
  { label: 'Blog', href: path === '/' ? '/#blog' : '/blog/', active: path.startsWith('/blog') || path === '/categories/' },
  { label: 'Contact', href: '/#contact', active: false },
];
---
  <header class="site-header" aria-label="Site header">
    <div class="shell header-inner">
      <a class="brand" href="/" aria-label="Vijayasankar Ravindran, home">VNR</a>
      <nav class="nav" id="primary-menu" aria-label="Primary navigation">
        {links.map(link => <a href={link.href} class:list={{ active: link.active }} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
      </nav>
      <div class="header-actions">
        <button class="theme-toggle" hidden type="button" aria-label="Switch to light theme" title="Switch to light theme">
          <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
          <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z"/></svg>
        </button>
        <button class="menu-toggle" hidden type="button" aria-controls="primary-menu" aria-expanded="false">
          <span>Menu</span>
          <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg class="close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg>
        </button>
      </div>
    </div>
  </header>
