---
import { projects } from '../../data/projects';
---
<section class="section" id="work" aria-labelledby="work-title">
  <div class="shell">
    <div class="section-heading"><h2 id="work-title">Work</h2></div>
    <div class="project-grid">
      {projects.map(project => {
        const Tag = project.link ? 'a' : 'article';
        return (
          <Tag class="project-card" href={project.link} target={project.link ? '_blank' : undefined} rel={project.link ? 'noopener' : undefined}>
            <div class="project-meta">
              <span>{project.meta}</span>
              {project.link && (
                <span class="project-link-icon" role="img" aria-label="Opens in a new tab">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4 10 14M10 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-5" /></svg>
                </span>
              )}
            </div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
          </Tag>
        );
      })}
    </div>
  </div>
</section>
