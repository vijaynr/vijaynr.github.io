---
import type { CollectionEntry } from 'astro:content';
import { formatDate, categoryId, readingMinutes, postTopics, postDescription } from '../lib/blog';
interface Props { posts: CollectionEntry<'blog'>[]; compact?: boolean; }
const { posts, compact = false } = Astro.props;
const Heading = compact ? 'h3' : 'h2';
---
<ul class:list={['post-list', { 'post-list-compact': compact }]}>
  {posts.map(post => (
    <li class="post-entry">
      <div class="post-dateline">
        <time class="post-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <span class="post-reading-time">{readingMinutes(post.body)} min read</span>
      </div>
      <div class="post-summary">
        <Heading class="post-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></Heading>
        <p>{postDescription(post)}</p>
        <div class="post-tail">
          <ul class="post-categories" aria-label="Tags">
            {postTopics(post).map(category => <li><a href={`/categories/#${categoryId(category)}`}>{category}</a></li>)}
          </ul>
          <a class="read-post" href={`/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}>
            Read article
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
          </a>
        </div>
      </div>
    </li>
  ))}
</ul>
