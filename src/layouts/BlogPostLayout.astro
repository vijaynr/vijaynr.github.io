---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { formatDate, categoryId, readingMinutes, postTopics, postDescription } from '../lib/blog';
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { title, pubDate, updatedDate, owner } = post.data;
const description = postDescription(post);
const categories = postTopics(post);
const initials = owner.split(/\s+/).filter(Boolean).map(part => part[0]).slice(0, 2).join('');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { '@type': 'Person', name: owner, ...(owner === 'Vijayasankar Ravindran' ? { url: Astro.site?.href } : {}) },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<BaseLayout surface="blog" title={`${title} — Vijayasankar Ravindran`} description={description} article publishedTime={pubDate.toISOString()} modifiedTime={updatedDate?.toISOString()}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <div class="shell writing-page article-page">
    <article class="note-article">
      <header class="article-header">
        <a class="article-back" href="/blog/">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" /></svg>
          Back to blog
        </a>
        <h1>{title}</h1>
        <div class="article-details">
          <span class="author-initials" aria-hidden="true">{initials}</span>
          <div>
            {owner === 'Vijayasankar Ravindran'
              ? <a class="article-author" href="/#background">{owner}</a>
              : <span class="article-author">{owner}</span>}
            <p class="article-meta"><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time><span>{readingMinutes(post.body)} min read</span></p>
          </div>
        </div>
        {updatedDate && <p class="post-date">Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></p>}
        <ul class="post-categories" aria-label="Tags">
          {categories.map(category => <li><a href={`/categories/#${categoryId(category)}`}>{category}</a></li>)}
        </ul>
      </header>
      <div class="prose reading-column"><slot /></div>
      <footer class="article-footer">
        <a class="text-link" href="/blog/">All posts</a>
        <a class="text-link" href="/feed.xml">Subscribe via RSS</a>
      </footer>
    </article>
  </div>
</BaseLayout>
